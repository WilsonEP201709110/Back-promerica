## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This file is a combination of the VisualStudio and JetBrains
## gitignore templates.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if using tasks.vs.json
# !.vs/tasks.vs.json

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-agent*

# Build Results of an external tool
[Aa]pp[Pp]ackages/
BundleArtifacts/
PackageArtifacts/
_Changelog*
ProjectLogs/

# StyleCop
StyleCopReport.xml

# Code Analysis results
MatrixTestResults/
_CodeAnalysis_*/
StyleCopReport.xml

# Python Tools for Visual Studio (PTVS)
__pycache__/
*.pyc

# Stress Testing Results
*.ss_log
*.ss_markers
*.ss_stats
*.ss_trace

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.bak

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Emulator
ecf/
rcf/

# Azure Stream Analytics local run output
ASALocalRun/

# Windows Azure Project (Cloud Service)
[Bb]inaries/

# Visual Studio Enterprise Storage
*.testsettings

# Visual Studio Local Workspace
$tf/

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web events (SAAS)
_xevents/

# SQL Server Insight
*.swp

# JustMock
*.JustMock

# ReSharper is a NuGet package and it's recommended to ignore its cache
_ReSharper*/
*.[Rr]e[Ss]harper.user
*.DotSettings.user

# TeamCity net6.0/net7.0/net8.0/net9.0/net10.0 test result file
*.results

# DotCover is a Code Coverage Tool
*.dotCover

# AxoCover is a Code Coverage Tool
.axoCover/*
!.axoCover/settings.json

# Coverlet is a Code Coverage Tool
coverage.json
coverage.xml
coverage.info

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# Rider
.idea/
*.sln.iml

# Windows image build artifacts
Thumbs.db
ehthumbs.db
Desktop.ini

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Others
*.cab
*.msi
*.msix
*.msm
*.msp

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# If using the NuGet Visual Studio Extension, it will create a packages.config file.
# That file SHOULD be committed to source control.
# !packages.config

# Specialized filenames
[Jj]ob_scheduling_data.xml
user.config

# OpenCover
*.opencoverxml

# Bower
bower_components/

# node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Visual Studio Task Runner
_less/
_sass/

# Typescript v1.1 expirely
atomiush/

# Serverless
.serverless/

# Dotenv
.env
.env.bak
.env.test
.env.library
.env.local
.env.dev
.env.development
.env.staging
.env.preview
.env.prod
.env.production

# Public/Private Keys
*.pem
*.pub
*.key
*.pfx

# Docker
.dockerignore
# !.dockerignore # Keep .dockerignore if you want it in git

# End of standard .NET gitignore
